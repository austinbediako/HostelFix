# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/hostelfix

# Auth (generate strong random strings, e.g. `openssl rand -base64 32`)
ACCESS_TOKEN_SECRET=change_me_access_token_secret
REFRESH_TOKEN_SECRET=change_me_refresh_token_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
BCRYPT_ROUNDS=12

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# CORS (Next.js frontend origin)
CORS_ORIGIN=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=hostelfix

# Email (dev uses stub logger)
EMAIL_PROVIDER=stub
EMAIL_FROM=noreply@hostelfix.ug.edu.gh
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Rate limits
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=100
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_ISSUE_WINDOW_MS=900000
RATE_LIMIT_ISSUE_MAX=20
RATE_LIMIT_COMMENT_WINDOW_MS=900000
RATE_LIMIT_COMMENT_MAX=30

# Issue workflow
RESOLVE_DISPUTE_WINDOW_HOURS=48

# Logging
LOG_LEVEL=info

# Seed-only
SYSTEM_ADMIN_EMAIL=admin@hostelfix.ug.edu.gh
SYSTEM_ADMIN_PASSWORD=change_me_admin_password
